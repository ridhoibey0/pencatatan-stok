# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tangkapan layar hasil scripts/ui-check.mjs
ui-shots/

# File export marketplace: berisi data penjualan asli (nomor pesanan, resi,
